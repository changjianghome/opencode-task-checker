    "README.md",
    "install.sh"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.21",
    "@opencode-ai/sdk": "1.18.21",
    "@types/bun": "1.2.14",
    "esbuild": "0.25.3",
    "typescript": "7.0.2"
  }
}