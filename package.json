{
  "name": "opencode-task-checker",
  "version": "1.1.0",
  "description": "OpenCode V1/V2 plugin: 3-minute idle status check for long-running tasks, with silent slash-command control and auto-interrupt on terminal replies.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js",
    "prepack": "npm run build"
  },
  "files": [
    "dist/index.js",
    "package.json",
    "README.md",
    "install.sh"
  ],
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.21",
    "@opencode/plugin": "2.0.21",
    "@opencode-ai/sdk": "1.18.21",
    "@types/bun": "1.2.14",
    "esbuild": "0.25.3",
    "typescript": "7.0.2"
  }
}
